# ============================================================
# comfyweb - puente local (agent). Copiar a agent/.env
# El AGENT_TOKEN tiene que ser EL MISMO que en el .env del servidor.
# ============================================================

# Servidor comfyweb del VPS (a donde sale este puente)
VPS_URL=https://vps-4455523-x.dattaweb.com
BASE_PATH=/comfyweb

# Token compartido con el servidor (obligatorio)
AGENT_TOKEN=

# Videocomfy local (la app que maneja ComfyUI en esta PC)
VIDEOCOMFY_HTTP=http://127.0.0.1:5634
VIDEOCOMFY_WS=ws://127.0.0.1:5634

# ComfyUI local (para el semáforo de estado y el cancelar)
COMFY_HTTP=http://127.0.0.1:8188

RECONEXION_MS=5000
