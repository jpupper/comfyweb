# ============================================================
# comfyweb - variables de entorno (LOCAL)
# Copiar a .env y completar. El .env NO se commitea.
# ============================================================

# --- SERVER ---
PORT=8085
NODE_ENV=local
BASE_PATH=/comfyweb
APP_ORIGIN=comfyweb

# --- BASE DE DATOS (propia de la app) ---
MONGODB_URI=mongodb://localhost:27017/comfyweb

# --- SEGURIDAD ---
JWT_SECRET=cambiar_por_el_jwt_secret_del_ecosistema

# --- FSCAUTH (SSO central) ---
FSCAUTH_URL=https://vps-4455523-x.dattaweb.com/fscauth
FSC_AUTH_API=http://localhost:3027/fscauth
FSC_INTERNAL_KEY=cambiar_por_la_clave_interna_compartida
FSC_PUBLIC_ORIGIN=https://fullscreencode.com

# --- PUENTE LOCAL (agent) ---
# Token compartido: el mismo valor acá y en agent/.env
AGENT_TOKEN=cambiar_por_un_token_largo_y_random

# --- MEDIA (Cloudflare R2, bucket compartido fscapps) ---
# Si falta, la app guarda el resultado en disco (public/media) como respaldo.
R2_BUCKET_NAME=fscapps
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- SOLO DESARROLLO LOCAL: acepta ?userId= sin sesion FSC (NUNCA en el VPS) ---
ALLOW_DEV_USER_ID=1

# --- DEPLOY ---
# VPS_HOST=
# VPS_PORT=5752
# VPS_USER=root
# GITHUB_TOKEN=
# GITHUB_REPO=jpupper/comfyweb
# FTP_HOST=
# FTP_USER=
# FTP_PASS=
# FTP_REMOTE_BASE=/comfyweb
